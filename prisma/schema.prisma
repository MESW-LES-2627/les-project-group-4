generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

// The connection URL lives in prisma.config.ts.
datasource db {
  provider = "postgresql"
}

model Room {
  id       Int    @id @default(autoincrement())
  name     String @db.VarChar(255)
  widthCm  Int    @map("width_cm")
  lengthCm Int    @map("length_cm")

  // US-02: the room list is ordered by createdAt, newest first.
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  // US-15: the room's location is either a seeded city or the browser's coordinates
  // (never both; POST /api/rooms checks that). Both are optional.
  cityId    Int?   @map("city_id")
  city      City?  @relation(fields: [cityId], references: [id], onDelete: SetNull)
  latitude  Float?
  longitude Float?

  // US-13: deleting a room deletes its saved layouts (and, through them, their items).
  layouts Layout[]

  @@map("room")
}

// CH-02 / US-07: catalog. Prices in integer cents (Prisma Decimal does not serialise
// as a plain JSON number). `slug` is the stable key the seed upserts by.
// `source` names the retailer that sells the item; in Iteration 4 (US-17) a Store
// table with the physical shops is added and linked to items BY `source`.
model Item {
  id           Int      @id @default(autoincrement())
  slug         String   @unique @db.VarChar(100)
  name         String   @db.VarChar(255)
  category     String   @db.VarChar(50)
  widthCm      Int      @map("width_cm")
  depthCm      Int      @map("depth_cm")
  heightCm     Int?     @map("height_cm")
  priceCents   Int      @map("price_cents")
  styleTags    String[] @default([]) @map("style_tags")
  roomTypeTags String[] @default([]) @map("room_type_tags")
  source       String   @db.VarChar(100)
  sourceUrl    String?  @map("source_url") @db.VarChar(500)

  // US-13: saved layouts that place this item. An item in a saved layout cannot be deleted.
  layoutItems LayoutItem[]

  @@index([category])
  @@map("item")

}

// CH-02 / US-15: seeded city list for "set my location".
model City {
  id        Int    @id @default(autoincrement())
  slug      String @unique @db.VarChar(100)
  name      String @db.VarChar(100)
  country   String @db.Char(2)
  latitude  Float
  longitude Float
  rooms     Room[]

  @@map("city")
}

// US-13 / US-14: a named layout saved under a room. The name is unique per room
// (US-13 AT-6), and deleting the room deletes its layouts (US-05 AT-5).
model Layout {
  id     Int    @id @default(autoincrement())
  roomId Int    @map("room_id")
  room   Room   @relation(fields: [roomId], references: [id], onDelete: Cascade)
  name   String @db.VarChar(100)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  items LayoutItem[]

  @@unique([roomId, name])
  @@map("layout")
}

// US-13: one catalog item placed in a saved layout. Field names match Placement in
// src/lib/geometry/plan.ts. `priceCents` is the catalog price when the layout was
// saved, so the total of a saved layout (US-12) does not change if the catalog does.
model LayoutItem {
  id          Int    @id @default(autoincrement())
  layoutId    Int    @map("layout_id")
  layout      Layout @relation(fields: [layoutId], references: [id], onDelete: Cascade)
  itemId      Int    @map("item_id")
  item        Item   @relation(fields: [itemId], references: [id], onDelete: Restrict)
  xCm         Float  @map("x_cm")
  yCm         Float  @map("y_cm")
  rotationDeg Float  @map("rotation_deg")
  priceCents  Int    @map("price_cents")

  @@index([layoutId])
  @@map("layout_item")
}
