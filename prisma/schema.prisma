generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

// The connection URL lives in prisma.config.ts.
datasource db {
  provider = "postgresql"
}

model Room {
  id       Int    @id @default(autoincrement())
  name     String @db.VarChar(255)
  widthCm  Int    @map("width_cm")
  lengthCm Int    @map("length_cm")

  @@map("room")
}

// CH-02 / US-07: catalog. Prices in integer cents (Prisma Decimal does not serialise
// as a plain JSON number). `slug` is the stable key the seed upserts by.
// `source` names the retailer that sells the item; in Iteration 4 (US-17) a Store
// table with the physical shops is added and linked to items BY `source`.
model Item {
  id           Int      @id @default(autoincrement())
  slug         String   @unique @db.VarChar(100)
  name         String   @db.VarChar(255)
  category     String   @db.VarChar(50)
  widthCm      Int      @map("width_cm")
  depthCm      Int      @map("depth_cm")
  heightCm     Int?     @map("height_cm")
  priceCents   Int      @map("price_cents")
  styleTags    String[] @default([]) @map("style_tags")
  roomTypeTags String[] @default([]) @map("room_type_tags")
  source       String   @db.VarChar(100)
  sourceUrl    String?  @map("source_url") @db.VarChar(500)

  @@index([category])
  @@map("item")

}

// CH-02 / US-15: seeded city list for "set my location".
model City {
  id        Int    @id @default(autoincrement())
  slug      String @unique @db.VarChar(100)
  name      String @db.VarChar(100)
  country   String @db.Char(2)
  latitude  Float
  longitude Float

  @@map("city")
}
