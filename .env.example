# Copy to .env to override. Optional for local development:
# without it, the app and Prisma use the Postgres from docker-compose.yaml.
# In staging/production, set both variables in the hosting provider instead.
DATABASE_URL=postgresql://furnimi:furnimi@localhost:5432/furnimi

# Only needed when migrations cannot use DATABASE_URL, i.e. on Supabase:
# session pooler (5432) for `prisma migrate deploy`, transaction pooler (6543)
# for the app. Leave unset locally; migrations then fall back to DATABASE_URL.
# DIRECT_DATABASE_URL=postgresql://postgres.<ref>:<password>@<host>:5432/postgres